---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-in">
    <span>© {year} Abdallah Saoud</span>
    <span class="right">
      <a href="mailto:abdousa392@gmail.com">e-mail</a>
      <a href="https://github.com/abdallahsaoud" rel="noopener" target="_blank">github</a>
      <a href="https://www.linkedin.com/in/abdallah-saoud-987aa6269/" rel="noopener" target="_blank">linkedin</a>
      <span class="made">fait avec Astro</span>
    </span>
  </div>
</footer>

<style>
  .footer {
    margin-top: 96px;
    border-top: 1px solid var(--line);
    padding: 28px 0 40px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }
  .footer-in {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .right {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .right a:hover {
    color: var(--fg);
  }
  .made {
    color: var(--muted-2);
  }
</style>
