---
import { identite } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="foot wrap">
  <b>à bientôt&nbsp;!</b>
  <span>© {year} {identite.nom}</span>
  <span class="links">
    <a href={`mailto:${identite.email}`}>e-mail</a>
    <a href={identite.github} target="_blank" rel="noopener">github</a>
    <a href={identite.linkedin} target="_blank" rel="noopener">linkedin</a>
    <span class="made">fait avec Astro</span>
  </span>
</footer>
