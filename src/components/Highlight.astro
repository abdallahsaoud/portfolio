---
interface Props {
  n: string;
  title: string;
  tag: string;
  problem: string;
  choice: string;
  result: string;
  caption?: string;
}

const { n, title, tag, problem, choice, result, caption } = Astro.props;
const hasDiagram = Astro.slots.has('default');
---

<article class="hl" id={`point-${n}`}>
  <header class="hl-head">
    <span class="n mono">{n}</span>
    <h3 class="mono">{title}</h3>
    <span class="tag mono">{tag}</span>
  </header>
  <div class:list={['hl-body', { 'with-diagram': hasDiagram }]}>
    {
      hasDiagram && (
        <figure class="diagram">
          <slot />
          {caption && <figcaption class="mono">{caption}</figcaption>}
        </figure>
      )
    }
    <div class="text">
      <p><strong>Problème.</strong> {problem}</p>
      <p><strong>Choix.</strong> {choice}</p>
      <p><strong>Résultat.</strong> {result}</p>
    </div>
  </div>
</article>

<style>
  .hl {
    padding: 44px 0;
    border-bottom: 1px solid var(--line);
  }
  .hl-head {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 14px;
    align-items: baseline;
    margin-bottom: 24px;
  }
  .n {
    font-size: 13px;
    color: var(--accent);
  }
  h3 {
    margin: 0;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .tag {
    font-size: 11.5px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 3px 8px;
    white-space: nowrap;
  }
  .hl-body {
    display: grid;
    gap: 32px;
  }
  .hl-body:not(.with-diagram) .text {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .hl-body:not(.with-diagram) .text p {
    margin: 0;
  }
  .with-diagram {
    grid-template-columns: 1.15fr 1fr;
    align-items: start;
  }
  .diagram {
    margin: 0;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 14px 10px;
  }
  .diagram :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    color: var(--fg);
  }
  figcaption {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
    margin: 10px 4px 0;
  }
  .text p {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.65;
    margin: 0 0 14px;
  }
  .text p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 820px) {
    .hl-head {
      grid-template-columns: 36px 1fr;
    }
    .tag {
      grid-column: 2;
      justify-self: start;
    }
    .with-diagram,
    .hl-body:not(.with-diagram) .text {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
