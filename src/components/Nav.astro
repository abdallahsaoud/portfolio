---
interface Props {
  page: 'accueil' | 'scorecast' | 'autre';
}

const { page } = Astro.props;
const home = '/';
const base = page === 'accueil' ? '' : home;
---

<header class="nav wrap">
  <a class="logo" href={home} aria-label="Abdallah Saoud, accueil">abdallah<i></i></a>
  <nav aria-label="Navigation principale">
    <a href={`${base}#projets`}>Projets</a>
    <a href={`${base}#parcours`}>Parcours</a>
    <a href={`${base}#contact`}>Contact</a>
  </nav>
</header>
