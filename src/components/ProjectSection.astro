---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
---

<article class="project" id={p.slug}>
  <div class="side">
    <div class="index mono">{p.index}</div>
    <h3 class="title mono">{p.title}</h3>
    <div class="status">{p.status}</div>
    <p class="meta">{p.meta}</p>
    <ul class="tags">
      {p.tags.map((t) => <li>{t}</li>)}
    </ul>
    {
      p.links.length > 0 && (
        <div class="links">
          {p.links.map((l) => (
            <a
              class="arrow"
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener' : undefined}
            >
              {l.label} →
            </a>
          ))}
        </div>
      )
    }
  </div>
  <div class="main">
    <p class="summary">{p.summary}</p>
    <ul class="points">
      {
        p.points.map((pt) => (
          <li>
            <strong>{pt.lead}</strong> {pt.text}
          </li>
        ))
      }
    </ul>
    {p.note && <p class="note">{p.note}</p>}
  </div>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    padding: 52px 0;
    border-bottom: 1px solid var(--line);
  }
  .index {
    font-size: 12px;
    color: var(--muted-2);
    margin-bottom: 10px;
  }
  .title {
    font-size: 24px;
    font-weight: 500;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .status {
    margin-bottom: 14px;
  }
  .meta {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 18px;
    line-height: 1.5;
  }
  .links {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }
  .summary {
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 22px;
  }
  .points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .points li {
    position: relative;
    padding-left: 22px;
    color: var(--muted);
    line-height: 1.6;
  }
  .points li::before {
    content: '›';
    position: absolute;
    left: 0;
    top: -1px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 18px;
  }
  .note {
    margin: 22px 0 0;
    padding: 14px 16px;
    border-left: 2px solid var(--line-strong);
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }
  @media (max-width: 820px) {
    .project {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 40px 0;
    }
    .links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 18px;
    }
  }
</style>
