      <path d="M0 0 L10 5 L0 10 z" fill="currentColor"></path>
    </marker>
  </defs>
  <g font-family="var(--mono)" font-size="12.5" fill="currentColor">
    <path d="M208 82 C 280 6, 440 6, 525 82" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-dasharray="4 4"></path>
    <text x="365" y="26" text-anchor="middle" fill-opacity=".6" text-decoration="line-through">recalcul à chaque requête</text>
    <text x="365" y="44" text-anchor="middle" fill="var(--accent)" font-size="10.5">WAU / MAU ne s'additionnent pas entre tranches</text>

    <rect x="14" y="88" width="108" height="48" fill="none" stroke="currentColor" rx="4"></rect>
