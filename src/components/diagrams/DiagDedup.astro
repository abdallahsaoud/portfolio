    <line x1="298" y1="217" x2="216" y2="217" stroke="currentColor" marker-end="url(#arr-d)"></line>
    <text x="257" y="209" text-anchor="middle" font-size="8.5" fill-opacity=".7">keepLastIfActive</text>

    <rect x="300" y="194" width="190" height="46" fill="none" stroke="currentColor" rx="4"></rect>
    <text x="312" y="213">nouveau job classement-42</text>
    <text x="312" y="230" font-size="9.5" fill-opacity=".7">remplace celui en attente</text>

    <text x="504" y="213" font-weight="600" fill="var(--accent)">✓ conservé</text>
