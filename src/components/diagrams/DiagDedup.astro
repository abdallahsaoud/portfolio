    <text x="14" y="30" font-size="10.5" letter-spacing="1.5" fill-opacity=".6">AVANT</text>
    <line x1="14" y1="40" x2="586" y2="40" stroke="currentColor" stroke-opacity=".2"></line>

    <rect x="14" y="60" width="200" height="46" fill="none" stroke="currentColor" stroke-opacity=".55" rx="4"></rect>
    <text x="26" y="79" fill-opacity=".8">job classement-42 ✓ fini</text>
    <text x="26" y="96" font-size="9.5" fill-opacity=".6">conservé après exécution</text>

    <line x1="214" y1="83" x2="298" y2="83" stroke="currentColor" stroke-opacity=".5" stroke-dasharray="3 3"></line>
