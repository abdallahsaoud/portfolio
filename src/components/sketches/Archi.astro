---
// « Comment c'est construit » : l'appli, la passerelle, le bus et les services avec leur base.
import Sk from './Sk.astro';
import Draw from './Draw.astro';
import { box, arrow, curve, db, type Scene } from './sk';

const names = ['comptes', 'matchs', 'pronos', 'ligues', 'chat'];
const blue = 'var(--blue)';
const red = 'var(--red)';
const mut = 'var(--mut)';

// Ordinateur : le bus est horizontal, les services alignés dessous.
const xs = [70, 165, 260, 355, 450];
const desktop: Scene = {
  ink: [
    { d: box(215, 14, 90, 42, 7), at: 0.2 },
    { d: arrow(260, 60, 260, 92), at: 0.6, t: 0.3 },
    { d: box(185, 96, 150, 46, 7), at: 0.8, t: 0.6 },
    { d: arrow(260, 146, 260, 178), at: 1.3, t: 0.3 },
    { d: 'M30 186H490', at: 1.6, t: 0.7, w: 4.6 },
    ...xs.map((x, k) => ({ d: arrow(x, 191, x, 221, 8), at: 2.2 + k * 0.1, t: 0.3 })),
    ...xs.map((x, k) => ({ d: box(x - 43, 226, 86, 42, 6), at: 2.4 + k * 0.1 })),
    ...xs.map((x, k) => ({ d: `M${x} 270V280${db(x, 288, 22, 20)}`, at: 3.1 + k * 0.1, w: 1.9 })),
  ],
  blue: [{ d: curve(384, 121, 362, 124, 342, 119), at: 1.5, t: 0.3 }],
  red: [{ d: curve(168, 350, 158, 336, 163, 322), at: 4, t: 0.3 }],
  packets: [70, 355, 260, 165, 450].map((x, k) => ({
    path: x === 260 ? 'M260 60V92M260 146V222' : `M260 60V92M260 146V186H${x}V222`,
    dur: 2.6,
    begin: k * 0.5,
  })),
  pkAt: 4.5,
  texts: [
    { x: 260, y: 43, s: 'l’appli', at: 0.5, size: 23 },
    { x: 260, y: 126, s: 'passerelle', at: 1.2, size: 19, kind: 'disp' },
    { x: 446, y: 113, s: 'une seule', at: 1.6, size: 22, fill: blue },
    { x: 446, y: 135, s: 'porte d’entrée', at: 1.7, size: 22, fill: blue },
    { x: 34, y: 174, s: 'bus de messages', at: 2.1, size: 21, anchor: 'start', fill: mut },
    ...xs.map((x, k) => ({ x, y: 254, s: names[k], at: 2.7 + k * 0.1, size: 21 })),
    { x: 40, y: 374, s: 'chacun sa base de données', at: 4.1, size: 25, anchor: 'start' as const, fill: red },
    { x: 500, y: 374, s: '(quinze services en vrai)', at: 4.4, size: 21, anchor: 'end' as const, fill: blue },
  ],
};

// Téléphone : le bus descend à gauche, un service par ligne, sa base à droite.
const ys = [204, 270, 336, 402, 468];
const mobile: Scene = {
  ink: [
    { d: box(65, 10, 100, 40, 7), at: 0.2 },
    { d: arrow(115, 54, 115, 84), at: 0.6, t: 0.3 },
    { d: box(40, 88, 150, 46, 7), at: 0.8, t: 0.6 },
    { d: arrow(60, 138, 60, 166), at: 1.3, t: 0.3 },
    { d: 'M60 172V530', at: 1.6, t: 0.8, w: 4.6 },
    ...ys.map((y, k) => ({ d: arrow(66, y, 102, y, 8), at: 2.2 + k * 0.12, t: 0.3 })),
    ...ys.map((y, k) => ({ d: box(108, y - 22, 118, 44, 6), at: 2.3 + k * 0.12 })),
    ...ys.map((y, k) => ({ d: `M230 ${y}H250${db(274, y - 10, 22, 20)}`, at: 3 + k * 0.12, w: 1.9 })),
  ],
  blue: [{ d: arrow(232, 111, 198, 111), at: 1.5, t: 0.3 }],
  red: [{ d: curve(262, 516, 274, 508, 276, 494), at: 4, t: 0.3 }],
  packets: ys.map((y, k) => ({ path: `M115 54V86M60 138V${y}H102`, dur: 2.8, begin: k * 0.55 })),
  pkAt: 4.4,
  texts: [
    { x: 115, y: 37, s: 'l’appli', at: 0.5, size: 21 },
    { x: 115, y: 118, s: 'passerelle', at: 1.2, size: 19, kind: 'disp' },
    { x: 240, y: 102, s: 'une seule', at: 1.6, anchor: 'start', fill: blue },
    { x: 240, y: 122, s: 'porte', at: 1.65, anchor: 'start', fill: blue },
    { x: 240, y: 142, s: 'd’entrée', at: 1.7, anchor: 'start', fill: blue },
    { x: 40, y: 351, s: 'bus de messages', at: 2.1, fill: mut, rot: -90 },
    ...ys.map((y, k) => ({ x: 167, y: y + 7, s: names[k], at: 2.5 + k * 0.12, size: 21 })),
    { x: 196, y: 540, s: 'chacun sa base de données', at: 4.1, size: 22, fill: red },
    { x: 196, y: 566, s: '(quinze services en vrai)', at: 4.4, fill: blue },
  ],
};
---

<Sk
  viewBox="0 0 520 388"
  mViewBox="0 0 340 578"
  label="Schéma au feutre : l’appli appelle une passerelle unique, qui publie sur un bus de messages relié à cinq services, chacun avec sa base de données. Il y en a quinze en réalité."
>
  <Draw {...desktop} />
  <Draw slot="mobile" {...mobile} />
</Sk>
