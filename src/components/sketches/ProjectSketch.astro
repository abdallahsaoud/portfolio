const ledColors = ['#e5484d', '#f5732a', '#f5a524', '#ffe45c', '#7bc86c', '#1f9d55', '#2f9fea', '#2f5bea', '#8b5cf6'];
const leds = [0, 1, 2, 3].flatMap((j) =>
  ledColors.map((c, i) => ({
    d: ring(22 + i * 32, 20 + j * 29, 10),
    style: `--d:${(0.1 + (i + j) * 0.05).toFixed(2)}s;--t:.35s;--c:${c};--ld:${(-(i * 0.12 + j * 0.08)).toFixed(2)}s`,
  })),
);
const s = scenes[slug];
---

{
  slug === 'aled' && (
    <Sk viewBox="0 0 300 150" label="Croquis au feutre d’un mur de LED : des pastilles qui se colorent en vague, au tempo.">
      <g class="ink" filter="url(#wob-s)">
        {leds.map((l) => (
          <path class="draw led" pathLength="1" d={l.d} style={l.style} stroke-width="1.7" />
        ))}
      </g>
      <g class="txt">
        <text class="lbl hand" x="150" y="144" text-anchor="middle" font-size="19" fill="var(--blue)" style="--d:1.2s">
          ♪ ça pulse au tempo
        </text>
      </g>
    </Sk>
  )
}
{
  s && (
    <Sk viewBox={s.viewBox} label={s.label}>
      <Draw small {...s.scene} />
    </Sk>
  )
}
