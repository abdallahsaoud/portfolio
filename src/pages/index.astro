---
import Layout from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Projet from '../components/Projet.astro';
import Parcours from '../components/Parcours.astro';
import Methode from '../components/Methode.astro';
import Contact from '../components/Contact.astro';
import { projects } from '../data/projects';
import { sections } from '../data/site';
---

<Layout
  title="Abdallah Saoud · développeur full-stack, plus à l’aise côté serveur"
  description="Développeur full-stack en alternance chez iDalgo sur Scorecast, dernière année du Mastère CTO & Tech Lead à HETIC. Portfolio : Scorecast, Hadjime Dem, Héritage, STORM, Aled."
  page="accueil"
>
  <Hero />

  <section class="sec wrap" id="projets">
    <div class="sec-head" data-play>
      <div>
        <span class="over rv">ce que j’ai construit</span>
        <h2 class="rv" style="--d:.08s">{sections.projets.titre}</h2>
      </div>
      <span class="sec-note rv" style="--d:.2s">{sections.projets.note}</span>
    </div>
    {projects.map((p, k) => <Projet project={p} k={k} />)}
  </section>

  <Parcours />
  <Methode />
  <Contact />
</Layout>
