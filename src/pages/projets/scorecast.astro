---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Base.astro';
import Decision from '../../components/Decision.astro';
import Archi from '../../components/sketches/Archi.astro';
import BackOffice from '../../components/sketches/BackOffice.astro';
import { loop } from '../../components/sketches/sk';
import happy from '../../assets/memoji-happy.png';
import { scorecast as s } from '../../data/scorecast';
import { projects } from '../../data/projects';
import { typo } from '../../utils/typo';

const home = '/';
// Le projet présenté juste après Scorecast sur l'accueil.
const next = projects[1];
const tilts = ['-1.2deg', '.9deg', '-.6deg', '1.1deg'];
const inks = ['var(--blue)', 'var(--red)', 'var(--grn)', 'var(--org)'];
---

<Layout
  title="Scorecast · étude de cas · Abdallah Saoud"
  description="Backend en microservices, back-office et infrastructure Kubernetes d’une application de pronostics sportifs en production. Six décisions techniques racontées."
  page="scorecast"
>
  <article class="wrap">
    <header class="sc-head">
      <div data-play>
        <a class="lnk sc-back rv" href={`${home}#projets`}>← retour aux projets</a>
        <p class="over sc-kicker rv" style="--d:.08s">{s.kicker}</p>
        <h1 class="rv" style="--d:.16s"><mark>{s.titre}</mark></h1>
        <p class="sc-lead rv" style="--d:.28s">{typo(s.lead)}</p>
      </div>
      <div class="sc-me" data-play>
        <p class="bulle rv" style="--d:.7s">ici, on entre dans le détail</p>
        <Image class="memoji" src={happy} alt="Le memoji d’Abdallah, les bras levés" width={400} loading="eager" />
      </div>
    </header>

    <dl class="metas">
      {
        s.meta.map((m, k) => (
          <div class="meta-card rv" style={`--r:${tilts[k]};--d:${(k * 0.08).toFixed(2)}s`} data-play data-hover>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
      <div class="meta-card rv" style={`--r:${tilts[3]};--d:.24s`} data-play data-hover>
        <dt>Stack</dt>
        <dd>
          <ul class="tags">
            {s.stack.map((t) => <li>{t}</li>)}
          </ul>
        </dd>
      </div>
    </dl>

    <ul class="figs" data-play>
      {
        s.figures.map((f, k) => (
          <li class="rv" style={`--d:${(k * 0.1).toFixed(1)}s`}>
            <span class="fig-n">
              <svg viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true" style={`stroke:${inks[k]}`}>
                <path class="dr" pathLength="1" style={`--d:${(0.5 + k * 0.15).toFixed(2)}s;--t:.8s`} d={loop(100, 40, 92, 31)} />
              </svg>
              <b data-count>{f.v}</b>
            </span>
            <span class="fig-l">{f.l}</span>
          </li>
        ))
      }
    </ul>

    <section class="sec archi" id="architecture">
      <div data-play>
        <span class="over rv">vu de l’intérieur</span>
        <h2 class="rv" style="--d:.08s">{s.architecture.titre}</h2>
        <p class="rv" style="--d:.18s">{typo(s.architecture.texte)}</p>
      </div>
      <Archi />
    </section>

    <section class="sec" id="decisions">
      <div class="sec-head" data-play>
        <div>
          <span class="over rv">le cœur du sujet</span>
          <h2 class="rv" style="--d:.08s">{s.decisionsTitre}</h2>
        </div>
        <span class="sec-note rv" style="--d:.2s">{s.decisionsNote}</span>
      </div>
      {s.decisions.map((d, k) => <Decision decision={d} k={k} />)}
    </section>

    <section class="sec front" id="back-office">
      <div class="archi rev">
        <div data-play>
          <span class="over rv">et côté front</span>
          <h2 class="rv" style="--d:.08s">{s.backoffice.titre}</h2>
          <p class="rv" style="--d:.18s">{typo(s.backoffice.texte)}</p>
          <ul class="tags rv" style="--d:.28s" aria-label="Technologies du back-office">
            {s.backoffice.stack.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <BackOffice />
      </div>
      <ul class="aussi front-pts" data-play>
        {
          s.backoffice.points.map((pt, k) => (
            <li class="rv" style={`--d:${(k * 0.1).toFixed(1)}s`}>
              <strong>{pt.lead}</strong>{pt.text.startsWith(':') ? '\u00a0' : ' '}{typo(pt.text)}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sec" id="aussi">
      <div class="sec-head" data-play>
        <div>
          <span class="over rv">et encore</span>
          <h2 class="rv" style="--d:.08s">{s.aussiTitre}</h2>
        </div>
      </div>
      <ul class="aussi" data-play>
        {
          s.aussi.map((a, k) => (
            <li class="rv" style={`--d:${(k * 0.1).toFixed(1)}s`}>
              <strong>{a.lead}</strong> {typo(a.text)}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sec learn" id="bilan">
      <div class="postit big rv" style="--r:-.7deg;--pc:#fff3a8" data-play data-hover>
        <h2>{s.retiensTitre}</h2>
        <ul>
          {s.retiens.map((t) => <li>{typo(t)}</li>)}
        </ul>
      </div>
      <div class="postit big alt rv" style="--r:.9deg;--pc:#d9e6ff;--d:.12s" data-play data-hover>
        <h2>{s.autrementTitre}</h2>
        <ul>
          {s.autrement.map((t) => <li>{typo(t)}</li>)}
        </ul>
      </div>
    </section>

    <nav class="pager" aria-label="Navigation entre projets">
      <a class="btn ghost" href={`${home}#projets`}><span aria-hidden="true">←</span> Retour aux projets</a>
      <a class="btn" href={`${home}#${next.slug}`}>Projet suivant : {next.title} <span aria-hidden="true">→</span></a>
    </nav>
  </article>
</Layout>
